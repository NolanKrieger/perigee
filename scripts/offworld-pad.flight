# M10 regression: a pad base lands on Vell's ice arc, builds a hopper from stored metal and local fuel, launches it to orbit, and sells from the pad.
# Test tool only (decision #16). The base and its stock are spawned in low Vell orbit (the transfer is covered by tutorial-t1-t10); the landing,
# the pad launch, the ascent to orbit and the sale go through the sim.
tutorial 11
spawn lander Lander orbit 120000 phase 0 fuel 1
stage
target Vell
until target_phase > 111 and target_phase < 115 timeout 3000
attitude prograde
wait 6
tap throttle_full
until next_body == 2 or apo > 11900000 timeout 300
tap throttle_cut
attitude off
warp 4
until body == 2 timeout 300000
warp 0
periapsis 20000 4000 900
warp 3
until t_peri < 120 timeout 200000
warp 0
attitude retrograde
wait 8
tap throttle_full
until apo < 45000 timeout 300
tap throttle_cut
attitude off
expect body == 2
# The pad base with 20 t of metal and 5 t of water in its surface tank.
spawn padbase PadBase orbit 25000 phase 0 fuel 1 cargo metal 4 cargo water 3
stage
tap legs
until ice_dist < 12000 and ice_dist > 0 timeout 5000
attitude retrograde
wait 3
tap throttle_full
until hspeed < 8 timeout 300
descent -40
until agl < 3000 timeout 900
descent -12
until agl < 150 timeout 300
attitude up
descent -3
until landed == 1 timeout 300
descent off
attitude off
expect landed == 1 and alive == 1 and outposts == 1 and pads == 1
view zoom 8
shot pad-base-landed
expect market == 3
log pad operational
ui builder-pad
shot pad-builder
ui builder
# Sell water from the pad's storage.
sell water 2
expect pool_water < 1.1 and pool_water > 0.9
# Build and launch a hopper from the pad: half cash, 1.5 t metal per t of parts, fuel from the base's tanks.
launch hopper2 Hop pad Vell
expect landed == 1 and body == 2 and fuel > 1.4
expect pool_metal < 4
view zoom 10
shot pad-launch
tap throttle_full
stage
until alt > 300 timeout 60
attitude pitch 35
until alt > 3000 timeout 120
attitude pitch 70
until apo > 30000 timeout 200
tap throttle_cut
attitude off
until t_apo < 25 timeout 2000
attitude pitch 90
tap throttle_full
until peri > 20000 or fuel < 0.05 timeout 200
tap throttle_cut
attitude off
expect peri > 15000 and apo < 120000 and body == 2
until rails == 1 timeout 30
expect rails == 1
log hopper in Vell orbit
view zoom 0.0028
shot pad-hopper-orbit
end
