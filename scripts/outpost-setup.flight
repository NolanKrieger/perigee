# M9 regression: scan Vell from orbit, then land an outpost (drill + refinery + panels) on the ice arc and let it produce in the background.
# Test tool only (decision #16). Orbital set-ups are spawned; the scan orbit, the landing and the production run through the sim.
tutorial 10
accept T10
# Get a craft to Vell the proven way (T9 transfer), then everything else is spawned around Vell relative to it.
spawn lander Lander orbit 120000 phase 0 fuel 1
stage
target Vell
until target_phase > 111 and target_phase < 115 timeout 3000
attitude prograde
wait 6
tap throttle_full
until next_body == 2 or apo > 11900000 timeout 300
tap throttle_cut
attitude off
warp 4
until body == 2 timeout 300000
warp 0
periapsis 20000 4000 900
warp 3
until t_peri < 120 timeout 200000
warp 0
attitude retrograde
wait 8
tap throttle_full
until apo < 45000 timeout 300
tap throttle_cut
attitude off
expect body == 2 and rails == 0 or body == 2
# Scanner probe: one full orbit with a resource scanner maps the deposits.
spawn scanprobe ScanProbe orbit 30000 phase 0 fuel 1
expect scanned == 0
warp 3
until scanned == 1 timeout 20000
warp 0
expect scanned == 1
log scanned
view zoom 0.0028
shot vell-scanned
# Outpost: land on the ice arc.
spawn outpost Outpost orbit 25000 phase 0 fuel 1
stage
tap legs
until ice_dist < 12000 and ice_dist > 0 timeout 5000
attitude retrograde
wait 3
tap throttle_full
until hspeed < 8 timeout 300
descent -40
until agl < 3000 timeout 900
descent -12
until agl < 150 timeout 300
attitude up
descent -3
until landed == 1 timeout 300
descent off
attitude off
expect landed == 1 and alive == 1 and in_ice == 1 and outposts == 1
view zoom 12
shot outpost-landed
expect power_gen > 0
ui transfer
shot outpost-panel
ui transfer
# Background production: three days pass at warp while the probe is active elsewhere.
active ScanProbe
warp 5
wait 64800
warp 0
active Outpost
expect store_ice > 0.1 or store_water > 0.1
expect store_water > 0.05
log produced
expect tutorial_step == 11
end
